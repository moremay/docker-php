<?xml version="1.0"?>
<ruleset name="MyProject">
    <!--
        本项目的 PHP_CodeSniffer 配置（PHP 跨版本兼容检查）。

        使用方法：
          1. 将本文件复制为 "phpcs.xml"（PHP_CodeSniffer 会自动识别该文件名）。
          2. 调整下方的配置（尤其是 "testVersion"）。
          3. 运行：vendor/bin/phpcs
    -->
    <!--
        PHP_CodeSniffer ruleset for this project (PHP cross-version compatibility).

        USAGE:
          1. Copy this file to "phpcs.xml" (PHP_CodeSniffer auto-detects phpcs.xml).
          2. Adjust the settings below (especially "testVersion").
          3. Run:  vendor/bin/phpcs
    -->
    <description>
        PHP_CodeSniffer ruleset for this project (PHP cross-version compatibility).

        USAGE:
          1. Copy this file to "phpcs.xml" (PHP_CodeSniffer auto-detects phpcs.xml).
          2. Adjust the settings below (especially "testVersion").
          3. Run:  vendor/bin/phpcs
    </description>

    <!-- ============================================================
         核心标准：PHPCompatibility（php-compatibility ^10）
         用于检测在下方 "testVersion" 配置的 PHP 版本中不可用的
         语言特性、函数、常量以及 ini 指令。
         ============================================================ -->
    <!-- ============================================================
         Core standard: PHPCompatibility (php-compatibility ^10)
         Reports on language features, functions, constants and ini
         directives that are not available in the PHP version(s)
         configured via "testVersion" below.
         ============================================================ -->
    <rule ref="PHPCompatibility"/>

    <!--
        可选：PHPCompatibilityPeclMcrypt
        仅当你的项目安装了 pecl/mcrypt 扩展时才启用。
        它会屏蔽所有与 mcrypt 相关的废弃/移除提示
        （mcrypt_* 函数、MCRYPT_* 常量、mcrypt.* ini 指令以及扩展本身），
        因为这些内容在安装了 pecl/mcrypt 后依然可用。

        需要本地包 phpcs/packages/phpcompatibility-pecl-mcrypt。
    -->
    <!--
        OPTIONAL: PHPCompatibilityPeclMcrypt
        Enable this only when your project installs the pecl/mcrypt
        extension. It suppresses all mcrypt-related deprecation/removal
        notices (mcrypt_* functions, MCRYPT_* constants, mcrypt.* ini
        directives and the extension itself), as those remain available
        when pecl/mcrypt is installed.

        Requires the local package phpcs/packages/phpcompatibility-pecl-mcrypt.
    -->
    <!-- <rule ref="PHPCompatibilityPeclMcrypt"/> -->

    <!--
        要检查兼容性的 PHP 版本。
          value="8.5"      -> 仅 PHP 8.5
          value="7.4-8.5"  -> PHP 7.4 至 8.5 的区间
    -->
    <!--
        PHP version(s) to check compatibility against.
          value="8.5"      -> only PHP 8.5
          value="7.4-8.5"  -> the range PHP 7.4 up to 8.5
    -->
    <config name="testVersion" value="8.5"/>

    <!-- 扫描大型代码库时提高内存限制。 -->
    <!-- Raise the memory limit when scanning large codebases. -->
    <ini name="memory_limit" value="1024M"/>

    <!-- 仅扫描 .php 扩展名的文件。 -->
    <!-- Only scan files with a .php extension. -->
    <arg name="extensions" value="php"/>

    <!-- 报告设置：写入文件、显示错误码和进度（-sp）。 -->
    <!-- Report settings: write to file, show error codes and progress (-sp). -->
    <arg name="report-file" value="PHPCS-report.txt"/>
    <arg name="report" value="code"/>
    <arg value="sp"/>

    <!--
        可选的忽略模式（按你的项目布局调整）。需要时取消注释：
    -->
    <!--
        Optional ignore patterns (adjust to your project layout). Uncomment to use:
    -->
    <!-- <exclude-pattern type="relative">^ebak/*</exclude-pattern> -->
    <!-- <exclude-pattern>*.tpl.php</exclude-pattern> -->
</ruleset>