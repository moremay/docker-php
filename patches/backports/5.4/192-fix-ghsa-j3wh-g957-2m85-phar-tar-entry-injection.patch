+static int phar_tar_type_has_data(char typeflag)
+{
+	switch (typeflag) {
+		case TAR_LINK:
+		case TAR_SYMLINK:
+		case TAR_CHAR:
+		case TAR_BLOCK:
+		case TAR_DIR:
+		case TAR_FIFO:
+			return 0;
+		default:
+			return 1;
+	}
+}
+
+/* Strict variant of phar_tar_number() for the size field: rejects anything the
+ * caller cannot represent instead of silently wrapping around. */
+static int phar_tar_size(const char *buf, size_t len, php_uint32 *result)
+{
+	php_uint32 num = 0;
+	size_t i = 0;
+
+	while (i < len && buf[i] == ' ') {
+		++i;
+	}
+
+	/* GNU base-256 encoding is only used for sizes that do not fit the octal field */
+	if (i < len && (((unsigned char) buf[i]) & 0x80)) {
+		return 0;
+	}
+
+	while (i < len && buf[i] >= '0' && buf[i] <= '7') {
+		/* the caller rounds the size up to the next 512 byte block, so leave
+		 * room for that on top of the uint32 the entry fields can hold */
+		if (num > (0xFFFFFFFFU - 511) / 8) {
+			return 0;
+		}
+		num = num * 8 + (buf[i] - '0');
+		++i;
+	}
+
+	while (i < len && (buf[i] == ' ' || buf[i] == '\0')) {
+		++i;
+	}
+
+	if (i != len || num > 0xFFFFFFFFU - 511) {
+		return 0;
+	}
+
+	*result = num;
+	return 1;
+}
